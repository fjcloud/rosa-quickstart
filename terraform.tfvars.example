# Cluster configuration
# cluster_name is overridden by: make deploy NAME=<name>
cluster_name = "my-cluster"
aws_region   = "eu-west-3"

# Required: explicitly select the organizer-approved ROSA HCP billing account.
# Set aws_billing_account_id here, or export BILLING_ACCOUNT_ID in your shell.
# aws_billing_account_id = "YOUR_APPROVED_12_DIGIT_ACCOUNT"

# Common tags for all resources (optional)
#global_tags = {
#  "app-code"      = "YOUR-APP-CODE"
#  "cost-center"   = "YOUR-COST-CENTER"
#  "owner"         = "your-email@company.com"
#  "service-phase" = "dev"
#}

# Network configuration
vpc_cidr                 = "10.10.0.0/16"
availability_zones_count = 3

# Workers. One zone needs at least 2. Three zones use one worker per zone when replicas is unset.
# compute_machine_type = "m7i.xlarge"
# replicas             = 3

# OpenShift version
openshift_version = "4.22.18"

# Opt out of the default OVN-Kubernetes CNI (same as: rosa create cluster --no-cni).
# Workers stay NotReady until you install your own CNI. Cannot be changed after create.
# no_cni = false
